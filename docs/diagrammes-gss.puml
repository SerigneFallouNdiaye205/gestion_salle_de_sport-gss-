@startuml GSS_Classes
title GSS - Diagramme de classes
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "com.gss.gss.model" {
  class Utilisateur {
    - id : int
    - username : String
    - password : String
    - type : String
    - statut : String
    - dateCreation : LocalDate
  }

  class Administrateur {
    - id : int
    - niveau_acces : String
  }

  class Receptionniste {
    - id : int
    - horaire_travail : String
  }

  class Membre {
    - id : int
    - nom : String
    - prenom : String
    - sexe : String
    - telephone : String
    - email : String
    - adresse : String
    - dateNaissance : LocalDate
    - dateInscription : LocalDate
    - statut : String
  }

  class Coach {
    - id : int
    - nom : String
    - prenom : String
    - telephone : String
    - email : String
    - specialite : String
    - salaire : Double
    - disponibilite : String
  }

  class Abonnement {
    - id : int
    - membreId : int
    - type : String
    - prix : Double
    - dateDebut : LocalDate
    - dateFin : LocalDate
    - statut : String
    + getJoursRestants() : long
    + estExpire() : boolean
  }

  class Paiement {
    - id : int
    - membreId : int
    - abonnementId : int
    - montant : double
    - datePaiement : LocalDateTime
    - modePaiement : String
    - statut : String
    - reference : String
  }

  class Seance {
    - id : int
    - coachId : int
    - nom : String
    - dateSeance : LocalDate
    - heureDebut : LocalTime
    - heureFin : LocalTime
    - salle : String
    - capacite : int
  }

  class InscriptionSeance {
    - id : int
    - membre_id : int
    - seance_id : int
    - date_inscription : LocalDate
    - statut : String
  }
}

package "com.gss.gss.controller" {
  class LoginController
  class DashboardController
  class MembreController
  class MembresFormController
  class AbonnementController
  class AbonnementFormController
  class PaiementsController
  class PaiementFormController
  class SeanceController
  class SeanceFormController
  class InscriptionSeanceController
  class InscriptionSeanceFormController
  class CoachController
  class CoachFormController
  class UtilisateursController
  class UtilisateursFormController
  class RapportsController
}

package "com.gss.gss.service" {
  class AuthService
  class DashboardService
  class MembreService
  class AbonnementService
  class PaiementService
  class SeanceService
  class InscriptionSeanceService
  class CoachService
  class UtilisateurService
}

package "com.gss.gss.dao" {
  participant UtilisateurDAO
  interface MembreDAO
  interface AbonnementDAO
  participant PaiementDAO
  interface SeanceDAO
  interface InscriptionSeanceDAO
  interface CoachDAO
}

package "com.gss.gss.dao.Impl" {
  class UtilisateurDAOImpl
  class MembreDAOImpl
  class AbonnementsDAOImpl
  class PaiementDAOImpl
  class SeanceDAOImpl
  class InscriptionSeanceDAOImpl
  class CoachDAOImpl
}

package "Sécurité et utilitaires" {
  class SessionManager <<singleton>>
  class PermissionManager <<utility>>
  class PasswordHasher <<utility>>
  class RecuPaiement <<utility>>
  class PaiementReferenceGenerator <<utility>>
}

package "Infrastructure" {
  class DatabaseConnection
  database "MySQL / MariaDB" as DB
}

' Les profils sont des enregistrements séparés dont l'identifiant
' est une clé étrangère vers utilisateurs ; ce ne sont pas des sous-classes Java.
Utilisateur "1" -- "0..1" Administrateur : profil / id partagé
Utilisateur "1" -- "0..1" Receptionniste : profil / id partagé
Utilisateur "1" -- "0..1" Coach : compte / id partagé

Membre "1" -- "0..*" Abonnement : possède
Membre "1" -- "0..*" Paiement : effectue
Abonnement "1" -- "0..*" Paiement : est réglé par
Coach "1" -- "0..*" Seance : anime
Membre "1" -- "0..*" InscriptionSeance : s'inscrit
Seance "1" -- "0..*" InscriptionSeance : reçoit

LoginController ..> AuthService
LoginController ..> SessionManager
DashboardController ..> DashboardService
MembreController ..> MembreService
MembresFormController ..> MembreService
AbonnementController ..> AbonnementService
AbonnementFormController ..> AbonnementService
PaiementsController ..> PaiementService
PaiementFormController ..> PaiementService
PaiementFormController ..> MembreService
PaiementFormController ..> AbonnementService
PaiementFormController ..> RecuPaiement
PaiementFormController ..> PaiementReferenceGenerator
SeanceController ..> SeanceService
SeanceFormController ..> SeanceService
InscriptionSeanceController ..> InscriptionSeanceService
InscriptionSeanceFormController ..> InscriptionSeanceService
CoachController ..> CoachService
CoachFormController ..> CoachService
UtilisateursController ..> UtilisateurService
UtilisateursFormController ..> UtilisateurService
RapportsController ..> DashboardService

AuthService ..> UtilisateurDAO
AuthService ..> PasswordHasher
MembreService ..> MembreDAO
AbonnementService ..> AbonnementDAO
PaiementService ..> PaiementDAO
SeanceService ..> SeanceDAO
InscriptionSeanceService ..> InscriptionSeanceDAO
InscriptionSeanceService ..> AbonnementService : contrôle l'abonnement
InscriptionSeanceService ..> SeanceService : vérifie la séance
CoachService ..> CoachDAO
UtilisateurService ..> UtilisateurDAO

UtilisateurDAOImpl ..|> UtilisateurDAO
MembreDAOImpl ..|> MembreDAO
AbonnementsDAOImpl ..|> AbonnementDAO
PaiementDAOImpl ..|> PaiementDAO
SeanceDAOImpl ..|> SeanceDAO
InscriptionSeanceDAOImpl ..|> InscriptionSeanceDAO
CoachDAOImpl ..|> CoachDAO

UtilisateurDAOImpl ..> DatabaseConnection
MembreDAOImpl ..> DatabaseConnection
AbonnementsDAOImpl ..> DatabaseConnection
PaiementDAOImpl ..> DatabaseConnection
SeanceDAOImpl ..> DatabaseConnection
InscriptionSeanceDAOImpl ..> DatabaseConnection
CoachDAOImpl ..> DatabaseConnection
DashboardService ..> DatabaseConnection
DatabaseConnection --> DB : JDBC

note right of PermissionManager
  Les droits sont déterminés selon le rôle
  de l'utilisateur conservé dans SessionManager.
end note
