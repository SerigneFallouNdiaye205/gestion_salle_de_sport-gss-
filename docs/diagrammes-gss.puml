@startuml GSS_Sequence_Authentification
title GSS - Séquence : authentification
autonumber

actor Utilisateur
boundary LoginController
control AuthService
interface UtilisateurDAO
database "MySQL / MariaDB" as DB
control PasswordHasher
control SessionManager
boundary Dashboard

Utilisateur -> LoginController : saisir identifiant et mot de passe
LoginController -> AuthService : login(username, password)
AuthService -> AuthService : valider les champs obligatoires
AuthService -> UtilisateurDAO : findByUsername(username)
UtilisateurDAO -> DB : SELECT utilisateur par username
DB --> UtilisateurDAO : utilisateur et hash BCrypt (ou aucun résultat)
UtilisateurDAO --> AuthService : Optional<Utilisateur>

alt utilisateur absent
  AuthService --> LoginController : erreur identifiants incorrects
  LoginController --> Utilisateur : afficher le message d'erreur
else compte désactivé
  AuthService -> AuthService : vérifier statut != ACTIF
  AuthService --> LoginController : erreur compte désactivé
  LoginController --> Utilisateur : afficher le message d'erreur
else compte actif
  AuthService -> PasswordHasher : verify(mot de passe, hash)
  alt mot de passe incorrect
    PasswordHasher --> AuthService : false
    AuthService --> LoginController : erreur identifiants incorrects
    LoginController --> Utilisateur : afficher le message d'erreur
  else authentification réussie
    PasswordHasher --> AuthService : true
    AuthService --> LoginController : Utilisateur
    LoginController -> SessionManager : login(utilisateur)
    LoginController -> LoginController : choisir dashboard selon le rôle
    LoginController -> Dashboard : charger dashboard.fxml
    Dashboard --> Utilisateur : afficher le tableau de bord
  end
end
@enduml

@startuml GSS_Sequence_Paiement
title GSS - Séquence : enregistrement d'un paiement et reçu
autonumber

actor "Administrateur / Réceptionniste" as Employe
boundary PaiementFormController
control PaiementService
interface PaiementDAO
database "MySQL / MariaDB" as DB
control RecuPaiement

Employe -> PaiementFormController : saisir membre, abonnement,\nmontant, date, mode et statut
PaiementFormController -> PaiementFormController : valider les champs et montant > 0
alt formulaire invalide
  PaiementFormController --> Employe : afficher les erreurs de saisie
else formulaire valide
  PaiementFormController -> PaiementFormController : construire Paiement\n(date/heure courante si création)
  PaiementFormController -> PaiementService : save(paiement)
  PaiementService -> PaiementDAO : save(paiement)
  PaiementDAO -> DB : INSERT INTO paiements
  DB --> PaiementDAO : résultat de l'insertion
  PaiementDAO --> PaiementService : succès / échec
  PaiementService --> PaiementFormController : résultat
  alt enregistrement réussi
    PaiementFormController -> RecuPaiement : generer(paiement)
    RecuPaiement --> PaiementFormController : fichier PDF
    opt bureau compatible
      PaiementFormController -> PaiementFormController : ouvrir le reçu PDF
    end
    PaiementFormController --> Employe : confirmer et fermer le formulaire
  else échec d'enregistrement
    PaiementFormController --> Employe : afficher l'erreur d'enregistrement
  end
end
@enduml

@startuml GSS_Sequence_InscriptionSeance
title GSS - Séquence : inscription d'un membre à une séance
autonumber

actor "Administrateur / Réceptionniste" as Employe
boundary InscriptionSeanceFormController
control InscriptionSeanceService
control AbonnementService
participant AbonnementDAO
control SeanceService
participant SeanceDAO
participant InscriptionSeanceDAO
database "MySQL / MariaDB" as DB

Employe -> InscriptionSeanceFormController : choisir membre et séance
InscriptionSeanceFormController -> InscriptionSeanceFormController : préparer inscription et date
InscriptionSeanceFormController -> InscriptionSeanceService : save(inscription)
InscriptionSeanceService -> InscriptionSeanceService : vérifier membre, séance et date requis

InscriptionSeanceService -> AbonnementService : findByMembreId(membreId)
AbonnementService -> AbonnementDAO : rechercher abonnements du membre
AbonnementDAO -> DB : SELECT abonnements
DB --> AbonnementDAO : liste d'abonnements
AbonnementDAO --> AbonnementService : abonnements
AbonnementService --> InscriptionSeanceService : abonnements

alt aucun abonnement ACTIF valide aujourd'hui
  InscriptionSeanceService --> InscriptionSeanceFormController : erreur abonnement non valide
  InscriptionSeanceFormController --> Employe : afficher le motif du refus
else abonnement actif et valide
  InscriptionSeanceService -> SeanceService : findById(seanceId)
  SeanceService -> SeanceDAO : findById(seanceId)
  SeanceDAO -> DB : SELECT séance
  DB --> SeanceDAO : séance (ou aucune)
  SeanceDAO --> SeanceService : séance
  SeanceService --> InscriptionSeanceService : séance
  alt séance inexistante
    InscriptionSeanceService --> InscriptionSeanceFormController : erreur séance introuvable
    InscriptionSeanceFormController --> Employe : afficher le motif du refus
  else séance trouvée
    InscriptionSeanceService -> InscriptionSeanceDAO : existsForMemberAndSession(...)
    InscriptionSeanceDAO -> DB : vérifier inscription existante
    DB --> InscriptionSeanceDAO : existe / n'existe pas
    InscriptionSeanceDAO --> InscriptionSeanceService : résultat
    alt membre déjà inscrit
      InscriptionSeanceService --> InscriptionSeanceFormController : erreur doublon
      InscriptionSeanceFormController --> Employe : afficher le motif du refus
    else inscription non dupliquée
      InscriptionSeanceService -> InscriptionSeanceDAO : countOccupants(seanceId)
      InscriptionSeanceDAO -> DB : compter les inscriptions non exclues
      DB --> InscriptionSeanceDAO : nombre d'inscrits
      InscriptionSeanceDAO --> InscriptionSeanceService : nombre d'inscrits
      alt capacité atteinte et inscription non annulée
        InscriptionSeanceService --> InscriptionSeanceFormController : erreur capacité maximale
        InscriptionSeanceFormController --> Employe : afficher le motif du refus
      else capacité disponible (ou statut ANNULEE)
        InscriptionSeanceService -> InscriptionSeanceDAO : save(inscription)
        InscriptionSeanceDAO -> DB : INSERT INTO inscriptions_seances
        DB --> InscriptionSeanceDAO : résultat de l'insertion
        InscriptionSeanceDAO --> InscriptionSeanceService : succès / échec
        InscriptionSeanceService --> InscriptionSeanceFormController : résultat
        InscriptionSeanceFormController --> Employe : confirmer ou signaler l'échec
      end
    end
  end
end
@enduml
