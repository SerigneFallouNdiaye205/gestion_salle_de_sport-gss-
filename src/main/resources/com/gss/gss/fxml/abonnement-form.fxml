<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gss.gss.controller.AbonnementFormController"
      spacing="15"
      prefWidth="500"
      prefHeight="500">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Gestion de l'abonnement"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="15" vgap="12">

        <Label text="ID membre :"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="membreIdField"
                   promptText="Ex : 1"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Type :"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="typeComboBox"
                  prefWidth="250"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1"/>

        <Label text="Prix :"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="prixField"
                   promptText="Ex : 10000"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Date début :"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="dateDebutPicker"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="1"/>

        <Label text="Date fin :"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="dateFinPicker"
                    GridPane.rowIndex="4"
                    GridPane.columnIndex="1"/>

        <Label text="Statut :"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="statutComboBox"
                  prefWidth="250"
                  GridPane.rowIndex="5"
                  GridPane.columnIndex="1"/>

    </GridPane>

    <Label fx:id="errorLabel"
           visible="false"
           managed="false"
           wrapText="true"
           style="-fx-text-fill: #dc2626;"/>

    <HBox spacing="10">

        <Button text="Enregistrer"
                onAction="#handleSave"
                prefWidth="120"/>

        <Button text="Annuler"
                onAction="#handleCancel"
                prefWidth="120"/>

    </HBox>

</VBox>