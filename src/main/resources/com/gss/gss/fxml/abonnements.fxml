<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.AbonnementController"
            prefWidth="1100.0"
            prefHeight="650.0"
            style="-fx-background-color: #f8fafc;">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="15.0" left="25.0"/>
            </padding>

            <Label text="Gestion des abonnements"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

            <Label text="Consultez, recherchez et gérez les abonnements des membres."
                   style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>

            <!-- Recherche + filtres -->
            <HBox spacing="10.0">

                <TextField fx:id="searchField"
                           promptText="Rechercher un abonnement..."
                           prefHeight="38.0"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleSearch"
                           style="-fx-background-color: white;
                                  -fx-border-color: #cbd5e1;
                                  -fx-border-radius: 6px;
                                  -fx-background-radius: 6px;
                                  -fx-padding: 0 12px;"/>

                <Button text="Rechercher"
                        onAction="#handleSearch"
                        prefHeight="38.0"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;">
                        <graphic>
                            <FontAwesomeIconView fill="#eff0f5" glyphName="SEARCH" size="15" />
                        </graphic>
                </Button>

                <ComboBox fx:id="typeComboBox"
                          prefWidth="155.0"
                          prefHeight="38.0"
                          onAction="#handleFilter"
                          promptText="Type"/>

                <ComboBox fx:id="statutComboBox"
                          prefWidth="140.0"
                          prefHeight="38.0"
                          onAction="#handleFilter"
                          promptText="Statut"/>

                <Button text="Actualiser"
                        onAction="#handleRefresh"
                        prefHeight="38.0"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="REFRESH" size="15" />
                    </graphic>
                </Button>

            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="5.0" right="25.0" bottom="10.0" left="25.0"/>
            </padding>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                        layoutX="125.0" layoutY="160.0"
                        prefHeight="400" prefWidth="900.0"
                        AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
                <AnchorPane prefHeight="400" prefWidth="900.0">
                    <TableView fx:id="abonnementsTable"
                               style="-fx-background-color: white;"
                               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="idColumn"
                                         text="ID"
                                         prefWidth="55.0"/>

                            <TableColumn fx:id="membreIdColumn"
                                         text="Membre"
                                         prefWidth="80.0"/>

                            <TableColumn fx:id="typeColumn"
                                         text="Type"
                                         prefWidth="130.0"/>

                            <TableColumn fx:id="prixColumn"
                                         text="Prix"
                                         prefWidth="100.0"/>

                            <TableColumn fx:id="dateDebutColumn"
                                         text="Date début"
                                         prefWidth="120.0"/>

                            <TableColumn fx:id="dateFinColumn"
                                         text="Date fin"
                                         prefWidth="120.0"/>

                            <TableColumn fx:id="statutColumn"
                                         text="Statut"
                                         prefWidth="110.0"/>

                            <TableColumn fx:id="joursRestantsColumn"
                                         text="Jours restants"
                                         prefWidth="120.0"/>

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>
                </AnchorPane>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0">
            <padding>
                <Insets top="10.0" right="25.0" bottom="20.0" left="25.0"/>
            </padding>

            <Button text="Nouvel abonnement"
                    onAction="#handleAdd"
                    prefHeight="40.0"
                    style="-fx-background-color: #16a34a;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="PLUS" size="10" />
                    </graphic>
            </Button>

            <Button text="Modifier"
                    onAction="#handleEdit"
                    prefHeight="40.0"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="EDIT" size="15" />
                    </graphic>
            </Button>

            <Button text="Suspendre"
                    onAction="#handleSuspend"
                    prefHeight="40.0"
                    style="-fx-background-color: #f59e0b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="PAUSE" size="15" />
                    </graphic>
            </Button>

            <Button text="Renouveler"
                    onAction="#handleRenew"
                    prefHeight="40.0"
                    style="-fx-background-color: #7c3aed;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                <graphic>
                    <FontAwesomeIconView fill="#eff0f5" glyphName="PLAY" size="15" />
                </graphic>
            </Button>

            <Button text="Supprimer"
                    onAction="#handleDelete"
                    prefHeight="40.0"
                    style="-fx-background-color: #dc2626;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="TRASH" size="15" />
                    </graphic>
            </Button>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label text="Sélectionnez un abonnement pour effectuer une action."
                   style="-fx-text-fill: #64748b;
                          -fx-font-size: 12px;"
                   alignment="CENTER_RIGHT"/>
        </HBox>
    </bottom>

</BorderPane>