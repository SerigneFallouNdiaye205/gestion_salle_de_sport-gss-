<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gss.gss.controller.AbonnementController">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
            </padding>

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Gestion des abonnements" />

            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Consultez, recherchez et gérez les abonnements des membres." />

            <!-- Recherche + filtres -->
            <HBox spacing="10.0">

                <TextField fx:id="searchField" onAction="#handleSearch" prefHeight="38.0" promptText="Rechercher un abonnement..." style="-fx-background-color: white;                                   -fx-border-color: #cbd5e1;                                   -fx-border-radius: 6px;                                   -fx-background-radius: 6px;                                   -fx-padding: 0 12px;" HBox.hgrow="ALWAYS" />

                <Button onAction="#handleSearch" prefHeight="38.0" style="-fx-background-color: #2563eb;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 6px;                                -fx-cursor: hand;" text="Rechercher">
                        <graphic>
                            <FontAwesomeIconView fill="#eff0f5" glyphName="SEARCH" size="15" />
                        </graphic>
                </Button>

                <ComboBox fx:id="typeComboBox" onAction="#handleFilter" prefHeight="38.0" prefWidth="155.0" promptText="Type" />

                <ComboBox fx:id="statutComboBox" onAction="#handleFilter" prefHeight="38.0" prefWidth="140.0" promptText="Statut" />

                <Button onAction="#handleRefresh" prefHeight="38.0"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;" text="Actualiser">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="REFRESH" size="15" />
                    </graphic>
                </Button>

            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" top="5.0" />
            </padding>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" layoutX="125.0" layoutY="160.0" prefHeight="400" prefWidth="900.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
                <AnchorPane prefHeight="400" prefWidth="900.0">
                    <TableView fx:id="abonnementsTable" style="-fx-background-color: white;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="idColumn" prefWidth="55.0" text="ID" />

                            <TableColumn fx:id="membreIdColumn" prefWidth="167.33328247070312" text="Membre" />

                            <TableColumn fx:id="typeColumn" prefWidth="91.33334350585938" text="Type" />

                            <TableColumn fx:id="prixColumn" prefWidth="100.0" text="Prix" />

                            <TableColumn fx:id="dateDebutColumn" prefWidth="120.0" text="Date début" />

                            <TableColumn fx:id="dateFinColumn" prefWidth="120.0" text="Date fin" />

                            <TableColumn fx:id="statutColumn" prefWidth="110.0" text="Statut" />

                            <TableColumn fx:id="joursRestantsColumn" prefWidth="120.0" text="Jours restants" />

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>

                    </TableView>
                </AnchorPane>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
            </padding>

            <Button onAction="#handleAdd" prefHeight="40.0"
                    style="-fx-background-color: #16a34a;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 6px;
                    -fx-cursor: hand;" text="Nouvel abonnement">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="PLUS" size="10" />
                    </graphic>
            </Button>

            <Button onAction="#handleEdit" prefHeight="40.0"
                    style="-fx-background-color: #2563eb;
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                        -fx-background-radius: 6px;
                        -fx-cursor: hand;" text="Modifier">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="EDIT" size="15" />
                    </graphic>
            </Button>

            <Button onAction="#handleSuspend" prefHeight="40.0" style="-fx-background-color: #f59e0b;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 6px;                            -fx-cursor: hand;" text="Suspendre">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="PAUSE" size="15" />
                    </graphic>
            </Button>

            <Button onAction="#handleRenew" prefHeight="40.0" style="-fx-background-color: #7c3aed;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 6px;                            -fx-cursor: hand;" text="Renouveler">
                <graphic>
                    <FontAwesomeIconView fill="#eff0f5" glyphName="PLAY" size="15" />
                </graphic>
            </Button>

            <Button onAction="#handleDelete" prefHeight="40.0" style="-fx-background-color: #dc2626;
            -fx-text-fill: white;
            -fx-font-weight: bold;
            -fx-background-radius: 6px;
            -fx-cursor: hand;" text="Supprimer">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="TRASH" size="15" />
                    </graphic>
            </Button>

            <HBox HBox.hgrow="ALWAYS" />

            <Label alignment="CENTER_RIGHT" style="-fx-text-fill: #64748b;                           -fx-font-size: 12px;" text="Sélectionnez un abonnement pour effectuer une action." />
        </HBox>
    </bottom>

</BorderPane>
