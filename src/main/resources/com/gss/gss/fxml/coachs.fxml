<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.CoachController"
            prefWidth="1100"
            prefHeight="650"
            style="-fx-background-color: #f8fafc;">

    <top>

        <VBox spacing="12">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="Gestion des coachs"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;"/>

            <Label text="Ajoutez, modifiez, recherchez et gérez les coachs de la salle."
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #64748b;"/>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Rechercher par nom, prénom, téléphone, email..."
                           prefHeight="38"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleSearch"
                           style="-fx-background-color: white;
                                  -fx-border-color: #cbd5e1;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 0 12px;"/>

                <Button text="Rechercher"
                        onAction="#handleSearch"
                        prefHeight="38"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="SEARCH" size="15" />
                    </graphic>
                </Button>

                <ComboBox fx:id="specialiteComboBox"
                          prefWidth="150"
                          prefHeight="38"
                          promptText="Spécialité"
                          onAction="#handleFilter"/>

                <ComboBox fx:id="disponibiliteComboBox"
                          prefWidth="150"
                          prefHeight="38"
                          promptText="Disponibilité"
                          onAction="#handleFilter"/>

                <Button text="Actualiser"
                        onAction="#handleRefresh"
                        prefHeight="38"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="REFRESH" size="15" />
                    </graphic>
                </Button>

            </HBox>

        </VBox>

    </top>

    <center>

        <VBox spacing="10">

            <padding>
                <Insets top="5"
                        right="25"
                        bottom="10"
                        left="25"/>
            </padding>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                        layoutX="125.0" layoutY="160.0"
                        prefHeight="400" prefWidth="900.0"
                        AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
                <AnchorPane prefHeight="400" prefWidth="900.0">
                    <TableView fx:id="coachsTable"
                               style="-fx-background-color: white;"
                               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="idColumn"
                                         text="ID"
                                         prefWidth="55"/>

                            <TableColumn fx:id="nomColumn"
                                         text="Nom"
                                         prefWidth="110"/>

                            <TableColumn fx:id="prenomColumn"
                                         text="Prénom"
                                         prefWidth="110"/>

                            <TableColumn fx:id="telephoneColumn"
                                         text="Téléphone"
                                         prefWidth="120"/>

                            <TableColumn fx:id="emailColumn"
                                         text="Email"
                                         prefWidth="180"/>

                            <TableColumn fx:id="specialiteColumn"
                                         text="Spécialité"
                                         prefWidth="130"/>

                            <TableColumn fx:id="salaireColumn"
                                         text="Salaire"
                                         prefWidth="100"/>

                            <TableColumn fx:id="disponibiliteColumn"
                                         text="Disponibilité"
                                         prefWidth="120"/>

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>
                </AnchorPane>
            </ScrollPane>
        </VBox>

    </center>

    <bottom>

        <HBox spacing="10">

            <padding>
                <Insets top="10"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button text="Nouveau coach"
                    onAction="#handleAdd"
                    prefHeight="40"
                    style="-fx-background-color: #16a34a;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                <graphic>
                    <FontAwesomeIconView fill="#eff0f5" glyphName="PLUS" size="10" />
                </graphic>
            </Button>

            <Button text="Modifier"
                    onAction="#handleEdit"
                    prefHeight="40"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                    <graphic>
                        <FontAwesomeIconView fill="#eff0f5" glyphName="EDIT" size="15" />
                    </graphic>
            </Button>

            <Button text="Supprimer"
                    onAction="#handleDelete"
                    prefHeight="40"
                    style="-fx-background-color: #dc2626;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6px;
                           -fx-cursor: hand;">
                <graphic>
                    <FontAwesomeIconView fill="#eff0f5" glyphName="TRASH" size="15" />
                </graphic>
            </Button>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label text="Sélectionnez un coach pour effectuer une action."
                   style="-fx-text-fill: #64748b;
                          -fx-font-size: 12px;"
                   alignment="CENTER_RIGHT"/>

        </HBox>

    </bottom>

</BorderPane>