<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import java.net.URL?>

<BorderPane prefHeight="720.0" prefWidth="1120.0"
            styleClass="coaches-page app-page"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.CoachController">
    <stylesheets>
        <URL value="@../css/style.css"/>
        <URL value="@../css/coachs.css"/>
    </stylesheets>
    <top>
        <VBox spacing="18" styleClass="page-header">
            <padding>
                <Insets bottom="22" left="30" right="30" top="28"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4">
                    <Label text="Coachs" styleClass="page-title"/>
                    <Label text="Pilotez l'équipe sportive et les disponibilités de la salle."
                           styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addButton" onAction="#handleAdd"
                        text="Nouveau coach" styleClass="primary-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="PLUS" size="13"/>
                    </graphic>
                </Button>
            </HBox>
            <GridPane hgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="0">
                    <Label text="COACHS AFFICHÉS" styleClass="metric-caption"/>
                    <Label fx:id="totalCoachsLabel" text="0" styleClass="metric-value"/>
                    <Label text="selon les filtres actifs" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="1">
                    <Label text="DISPONIBLES" styleClass="metric-caption"/>
                    <Label fx:id="disponiblesLabel" text="0">
                        <styleClass>
                            <String fx:value="metric-value"/>
                            <String fx:value="metric-positive"/>
                        </styleClass>
                    </Label>
                    <Label text="prêts à encadrer une séance" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="2">
                    <Label text="INDISPONIBLES" styleClass="metric-caption"/>
                    <Label fx:id="indisponiblesLabel" text="0">
                        <styleClass>
                            <String fx:value="metric-value"/>
                            <String fx:value="metric-warning"/>
                        </styleClass>
                    </Label>
                    <Label text="à planifier ultérieurement" styleClass="metric-detail"/>
                </VBox>
            </GridPane>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="filter-bar">
                <TextField fx:id="searchField" onAction="#handleSearch"
                           promptText="Rechercher un nom, une spécialité, un téléphone..."
                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleSearch" text="Rechercher"
                        styleClass="primary-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="13"/>
                    </graphic>
                </Button>
                <ComboBox fx:id="specialiteComboBox" onAction="#handleFilter"
                          promptText="Spécialité" styleClass="filter-box"/>
                <ComboBox fx:id="disponibiliteComboBox" onAction="#handleFilter"
                          promptText="Disponibilité" styleClass="filter-box"/>
                <Button onAction="#handleRefresh" text="Réinitialiser"
                        styleClass="ghost-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="13"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="table-section">
            <padding>
                <Insets bottom="18" left="30" right="30" top="18"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Équipe des coachs" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sélectionnez une ligne pour modifier ou supprimer un coach."
                       styleClass="helper-text"/>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="table-scroll">
                <TableView fx:id="coachsTable" styleClass="coaches-table">
                    <placeholder>
                        <Label text="Aucun coach ne correspond aux critères."
                               style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="idColumn" text="#" prefWidth="55"/>
                        <TableColumn fx:id="nomColumn" text="Nom" prefWidth="120"/>
                        <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="125"/>
                        <TableColumn fx:id="telephoneColumn" text="Téléphone" prefWidth="125"/>
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                        <TableColumn fx:id="specialiteColumn" text="Spécialité" prefWidth="145"/>
                        <TableColumn fx:id="salaireColumn" text="Salaire" prefWidth="110"/>
                        <TableColumn fx:id="disponibiliteColumn" text="Statut" prefWidth="135"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </ScrollPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-bar">
            <padding>
                <Insets bottom="22" left="30" right="30" top="8"/>
            </padding>
            <Button fx:id="editButton" onAction="#handleEdit" text="Modifier"
                    styleClass="secondary-button">
                <graphic>
                    <FontAwesomeIconView glyphName="EDIT" size="13"/>
                </graphic>
            </Button>
            <Button fx:id="deleteButton" onAction="#handleDelete" text="Supprimer"
                    styleClass="danger-button">
                <graphic>
                    <FontAwesomeIconView glyphName="TRASH" size="13"/>
                </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Les informations professionnelles restent accessibles à l'administrateur."
                   styleClass="helper-text"/>
        </HBox>
    </bottom>
</BorderPane>
