<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.LoginController">
   <children>
      <VBox alignment="CENTER" layoutX="-2.0" prefHeight="400.0"
            prefWidth="215.0" style="-fx-background-color: #3051A0;"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.topAnchor="0.0">
         <children>
            <Text fill="#eff0f5" strokeType="OUTSIDE"
                  strokeWidth="0.0" text="Bienvenue">
               <font>
                  <Font name="Times New Roman Bold" size="26.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Text>
            <Text fill="#eff0f5" strokeType="OUTSIDE" strokeWidth="0.0"
                  text="Dans ton appli de gestion">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font>
            </Text>
            <Text fill="#eff0f5" strokeType="OUTSIDE" strokeWidth="0.0"
                  text="de ta salle de sport !">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font>
            </Text>
         </children></VBox>
      <VBox alignment="CENTER" layoutX="198.0" layoutY="14.0"
            prefHeight="400.0" prefWidth="387.0" spacing="20.0"
            AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="GSS">
               <font>
                  <Font name="Times New Roman Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Text>
            <TextField fx:id="usernameField" maxHeight="30.0" maxWidth="250.0"
                       prefHeight="30.0" prefWidth="250.0"
                       promptText="Entrez votre nom d'utilisateur">
               <font>
                  <Font name="Times New Roman" size="12.0" />
               </font>
            </TextField>
            <PasswordField fx:id="passwordField" maxHeight="30.0" maxWidth="250.0"
                           prefHeight="30.0" prefWidth="250.0"
                           promptText="Entrez votre mot de passe">
               <font>
                  <Font name="Times New Roman" size="12.0" />
               </font>
            </PasswordField>
            <Label fx:id="errorLabel" managed="false" textFill="#dc2626"
                   visible="false" wrapText="true">
               <font>
                  <Font name="Times New Roman" size="12.0" />
               </font>
            </Label>
            <Button fx:id="loginButton" maxHeight="30.0" maxWidth="250.0"
                    mnemonicParsing="false" onAction="#handleLogin" prefHeight="30.0"
                    prefWidth="250.0" style="-fx-background-color: #3051A0;"
                    text="Se Connecter" textFill="#eff0f5">
               <font>
                  <Font name="Times New Roman Bold" size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleExit"
                    style="-fx-background-color: transparent;" text="Quitter">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
