<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefWidth="780.0" prefHeight="480.0"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.MemberSubscriptionRequestsController">
    <top>
        <VBox spacing="8">
            <padding><Insets top="18" right="20" bottom="12" left="20"/></padding>
            <Label text="Demandes d'abonnement des membres"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #17365d;"/>
            <Label text="La validation enregistre un paiement réellement encaissé puis crée l'abonnement."
                   wrapText="true" style="-fx-text-fill: #64748b;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
            <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="N°" prefWidth="60"/>
                    <TableColumn fx:id="memberColumn" text="Membre" prefWidth="260"/>
                    <TableColumn fx:id="typeColumn" text="Formule demandée" prefWidth="190"/>
                    <TableColumn fx:id="dateColumn" text="Date de demande" prefWidth="210"/>
                </columns>
            </TableView>
            <Label fx:id="messageLabel" style="-fx-text-fill: #64748b;"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="12" right="20" bottom="18" left="20"/></padding>
            <Button text="Actualiser" onAction="#handleRefresh"/>
            <Button text="Refuser" onAction="#handleReject"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white;"/>
            <Button text="Confirmer le paiement et activer" onAction="#handleApprove"
                    style="-fx-background-color: #0f766e; -fx-text-fill: white;"/>
            <Button text="Fermer" onAction="#handleClose"/>
        </HBox>
    </bottom>
</BorderPane>
