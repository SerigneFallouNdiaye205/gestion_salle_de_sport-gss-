<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gss.gss.controller.SeanceController">
    <top>
        <VBox spacing="5">
            <padding><Insets bottom="15" left="20" right="20" top="20" /></padding>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestion des séances" />
            <Label style="-fx-text-fill: #64748b;" text="Planification et gestion des séances de la salle de sport" />
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets bottom="15" left="20" right="20" top="5" /></padding>
            <HBox alignment="CENTER" spacing="10">
                <Label alignment="CENTER_LEFT" style="-fx-text-fill: #64748b;                     -fx-font-size: 12px;" text="Sélectionnez une seance pour effectuer une action." />
                <HBox HBox.hgrow="ALWAYS" />
                <Button minHeight="38.0" onAction="#handleAdd" prefHeight="38.0" style="-fx-background-color: #16a34a; -fx-background-radius: 6px; -fx-text-fill: white;" text="Nouvelle séance">
                    <graphic><FontAwesomeIconView fill="white" glyphName="PLUS" size="10" /></graphic>
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font>
                </Button>
                <Button minHeight="38.0" onAction="#handleEdit" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-background-radius: 6px; -fx-text-fill: white;" text="Modifier">
                    <graphic><FontAwesomeIconView fill="white" glyphName="EDIT" size="15" /></graphic>
                    <font>
                        <Font name="System Bold Italic" size="12.0" />
                    </font>
                </Button>
                <Button minHeight="38.0" onAction="#handleDelete" prefHeight="38.0" style="-fx-background-color: #dc2626; -fx-background-radius: 6px; -fx-text-fill: white;" text="Supprimer">
                    <graphic><FontAwesomeIconView fill="white" glyphName="TRASH" size="15" /></graphic>
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font>
                </Button>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="541.0" prefWidth="861.0">
                <TableView fx:id="tableSeances" prefHeight="450">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="55" text="ID" />
                        <TableColumn fx:id="colCoach" prefWidth="150" text="Coach" />
                        <TableColumn fx:id="colNom" prefWidth="150" text="Séance" />
                        <TableColumn fx:id="colDate" prefWidth="110" text="Date" />
                        <TableColumn fx:id="colHeureDebut" prefWidth="90" text="Début" />
                        <TableColumn fx:id="colHeureFin" prefWidth="90" text="Fin" />
                        <TableColumn fx:id="colSalle" prefWidth="120" text="Salle" />
                        <TableColumn fx:id="colCapacite" prefWidth="90" text="Capacité" />
                    </columns>
                </TableView>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
