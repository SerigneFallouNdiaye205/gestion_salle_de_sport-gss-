<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane prefHeight="720.0" prefWidth="1120.0"
            styleClass="coaches-page app-page"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.SeanceController">
    <stylesheets>
        <URL value="@../css/style.css"/>
        <URL value="@../css/coachs.css"/>
    </stylesheets>

    <top>
        <VBox spacing="18" styleClass="page-header">
            <padding>
                <Insets bottom="22" left="30" right="30" top="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4">
                    <Label text="Séances" styleClass="page-title"/>
                    <Label text="Planifiez les activités sportives et consultez le planning de la salle."
                           styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addButton" onAction="#handleAdd"
                        text="Nouvelle séance" styleClass="primary-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="PLUS" size="13"/>
                    </graphic>
                </Button>
            </HBox>

            <GridPane hgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="0">
                    <Label text="PLANNING" styleClass="metric-caption"/>
                    <Label text="Séances programmées" styleClass="metric-value"/>
                    <Label text="Consultez le calendrier sportif de la salle"
                           styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="1">
                    <Label text="ENCADREMENT" styleClass="metric-caption"/>
                    <Label text="Coachs affectés" styleClass="metric-value"/>
                    <Label text="Chaque séance est associée à un coach"
                           styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="2">
                    <Label text="CAPACITÉ" styleClass="metric-caption"/>
                    <Label text="Places disponibles" styleClass="metric-value"/>
                    <Label text="La capacité est définie par séance"
                           styleClass="metric-detail"/>
                </VBox>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="table-section">
            <padding>
                <Insets bottom="18" left="30" right="30" top="18"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Planning des séances" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sélectionnez une ligne pour modifier ou supprimer une séance."
                       styleClass="helper-text"/>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="table-scroll">
                <TableView fx:id="tableSeances" styleClass="coaches-table">
                    <placeholder>
                        <Label text="Aucune séance programmée."
                               style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="#" prefWidth="55"/>
                        <TableColumn fx:id="colCoach" text="Coach" prefWidth="160"/>
                        <TableColumn fx:id="colNom" text="Séance" prefWidth="170"/>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colHeureDebut" text="Début" prefWidth="95"/>
                        <TableColumn fx:id="colHeureFin" text="Fin" prefWidth="95"/>
                        <TableColumn fx:id="colSalle" text="Salle" prefWidth="130"/>
                        <TableColumn fx:id="colCapacite" text="Capacité" prefWidth="95"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-bar">
            <padding>
                <Insets bottom="22" left="30" right="30" top="8"/>
            </padding>
            <Button fx:id="editButton" onAction="#handleEdit" text="Modifier"
                    styleClass="secondary-button">
                <graphic>
                    <FontAwesomeIconView glyphName="EDIT" size="13"/>
                </graphic>
            </Button>
            <Button fx:id="deleteButton" onAction="#handleDelete" text="Supprimer"
                    styleClass="danger-button">
                <graphic>
                    <FontAwesomeIconView glyphName="TRASH" size="13"/>
                </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Les coachs peuvent consulter uniquement leurs séances."
                   styleClass="helper-text"/>
        </HBox>
    </bottom>
</BorderPane>
