<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.PasswordField?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gss.gss.controller.UtilisateursFormController"
      spacing="15"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label fx:id="titleLabel"
           text="Nouvel utilisateurs"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #111827;"/>

    <GridPane hgap="15"
              vgap="12">

        <Label text="Nom d'utilisateur :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="usernameField"
                   promptText="Nom d'utilisateur"
                   prefWidth="250"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Mot de passe :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <PasswordField fx:id="passwordField"
                   promptText="Mot de passe"
                   prefWidth="250"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Type d'utilisateur :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <ComboBox fx:id="typeComboBox"
                  prefWidth="250"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"
                  promptText="Type"/>


        <Label text="Date de creation :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <DatePicker fx:id="dateCreationPicker"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="3"/>


        <Label text="Statut :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <ComboBox fx:id="statutComboBox"
                  prefWidth="250"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4"
                  promptText="Statut"/>

    </GridPane>

    <Label fx:id="errorLabel"
           visible="false"
           managed="false"
           wrapText="true"
           style="-fx-text-fill: #dc2626;"/>

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Annuler"
                onAction="#handleCancel"
                prefWidth="100"/>

        <Button fx:id="saveButton"
                text="Enregistrer"
                onAction="#handleSave"
                prefWidth="120"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

    </HBox>

</VBox>