<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane prefHeight="720.0" prefWidth="1120.0"
            styleClass="coaches-page app-page"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gss.gss.controller.UtilisateursController">
    <stylesheets>
        <URL value="@../css/style.css"/>
        <URL value="@../css/coachs.css"/>
    </stylesheets>

    <top>
        <VBox spacing="18" styleClass="page-header">
            <padding>
                <Insets bottom="22" left="30" right="30" top="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4">
                    <Label text="Utilisateurs" styleClass="page-title"/>
                    <Label text="Consultez et gérez les comptes et les accès de l'application."
                           styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleAdd"
                        text="Nouvel utilisateur" styleClass="primary-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="PLUS" size="13"/>
                    </graphic>
                </Button>
            </HBox>

            <GridPane hgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="0">
                    <Label text="COACHS ACTIFS" styleClass="metric-caption"/>
                    <Label fx:id="coachsActifsLabel" text="0" styleClass="metric-value"/>
                    <Label text="comptes coach actifs" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="1">
                    <Label text="RÉCEPTIONNISTES ACTIFS" styleClass="metric-caption"/>
                    <Label fx:id="receptionnistesActifsLabel" text="0" styleClass="metric-value"/>
                    <Label text="comptes réceptionnistes actifs" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="4" styleClass="metric-card" GridPane.columnIndex="2">
                    <Label text="ADMINISTRATEURS ACTIFS" styleClass="metric-caption"/>
                    <Label fx:id="administrateursActifsLabel" text="0" styleClass="metric-value"/>
                    <Label text="comptes administrateurs actifs" styleClass="metric-detail"/>
                </VBox>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="filter-bar">
                <TextField fx:id="searchField" onAction="#handleSearch"
                           promptText="Rechercher un nom d'utilisateur, un type..."
                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleSearch" text="Rechercher"
                        styleClass="primary-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="13"/>
                    </graphic>
                </Button>
                <ComboBox fx:id="statusComboBox"
                          promptText="Statut" styleClass="filter-box"/>
                <ComboBox fx:id="typeComboBox"
                          promptText="Type" styleClass="filter-box"/>
                <Button onAction="#handleRefresh" text="Réinitialiser"
                        styleClass="ghost-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="13"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="table-section">
            <padding>
                <Insets bottom="18" left="30" right="30" top="18"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Comptes utilisateurs" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Sélectionnez une ligne pour modifier ou supprimer un compte."
                       styleClass="helper-text"/>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="table-scroll">
                <TableView fx:id="utilisateursTable" styleClass="coaches-table">
                    <placeholder>
                        <Label text="Aucun utilisateur ne correspond aux critères."
                               style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="idColumn" text="#" prefWidth="55"/>
                        <TableColumn fx:id="usernameColumn" text="Nom d'utilisateur" prefWidth="210"/>
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="180"/>
                        <TableColumn fx:id="dateCreationColumn" text="Date de création" prefWidth="180"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="140"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-bar">
            <padding>
                <Insets bottom="22" left="30" right="30" top="8"/>
            </padding>
            <Button onAction="#handleEdit" text="Modifier"
                    styleClass="secondary-button">
                <graphic>
                    <FontAwesomeIconView glyphName="EDIT" size="13"/>
                </graphic>
            </Button>
            <Button onAction="#handleDelete" text="Supprimer"
                    styleClass="danger-button">
                <graphic>
                    <FontAwesomeIconView glyphName="TRASH" size="13"/>
                </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="La gestion des utilisateurs est réservée à l'administrateur."
                   styleClass="helper-text"/>
        </HBox>
    </bottom>
</BorderPane>
